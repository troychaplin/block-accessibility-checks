# @wordpress/scripts bundles its own webpack/babel/eslint/stylelint toolchain and
# expects an npm-style flat node_modules. Config files here reference packages that
# arrive transitively (babel.config.json -> @babel/preset-env, @babel/preset-react),
# which pnpm's default isolated linker would not expose at the project root.
node-linker=hoisted

# WordPress packages declare wide/duplicated peer ranges; don't fail installs on them.
strict-peer-dependencies=false
