{
	"name": "block-accessibility-checks",
	"version": "4.1.0",
	"description": "Add block checks in the editor to support publishing accessible content",
	"author": "Troy Chaplin",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"packageManager": "pnpm@10.34.2",
	"lint-staged": {
		"*.{css,scss}": [
			"stylelint --fix",
			"git add"
		],
		"*.js": [
			"wp-scripts format",
			"wp-scripts lint-js",
			"git add"
		],
		"*.php": [
			"composer run format",
			"git add"
		]
	},
	"files": [
		"[^.]*"
	],
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"format": "pnpm format:js && pnpm format:php && pnpm format:css",
		"format:js": "wp-scripts lint-js --fix",
		"format:php": "composer run format",
		"format:css": "stylelint \"**/*.scss\" --fix",
		"lint": "pnpm lint:js && pnpm lint:php && pnpm lint:css",
		"lint:js": "wp-scripts lint-js",
		"lint:php": "composer run lint",
		"lint:css": "stylelint \"**/*.scss\"",
		"clean": "rm -rf node_modules pnpm-lock.yaml && pnpm install && pnpm build",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"prepare": "husky"
	},
	"devDependencies": {
		"@wordpress/compose": "^8.6.0",
		"@wordpress/data": "10.53.0",
		"@wordpress/element": "8.5.0",
		"@wordpress/env": "11.13.0",
		"@wordpress/eslint-plugin": "25.9.0",
		"@wordpress/hooks": "^4.53.0",
		"@wordpress/i18n": "6.26.0",
		"@wordpress/plugins": "7.53.0",
		"@wordpress/prettier-config": "4.53.0",
		"@wordpress/scripts": "34.1.0",
		"@wordpress/stylelint-config": "24.2.0",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "10.1.8",
		"husky": "9.1.7",
		"stylelint": "17.14.1",
		"stylelint-scss": "7.2.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.53.0",
		"@wordpress/components": "^39.0.0",
		"@wordpress/dataviews": "^18.0.0",
		"@wordpress/icons": "^15.4.0",
		"tldts": "^7.4.10"
	},
	"pnpm": {
		"ignoredBuiltDependencies": [
			"@parcel/watcher",
			"core-js",
			"core-js-pure",
			"fs-ext-extra-prebuilt",
			"unrs-resolver"
		]
	}
}
