{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Block Accessibility Checks Demo",
    "author": "troychaplin",
    "description": "Block Accessibility Checks with an external integration example plugin, sample page, and Band custom post type content."
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "landingPage": "/",
  "steps": [
    {
      "step": "login"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/troychaplin/block-accessibility-checks",
        "ref": "main",
        "refType": "branch",
        "path": "/"
      },
      "options": {
        "activate": true,
        "targetFolderName": "block-accessibility-checks"
      },
      "progress": {
        "caption": "Installing Block Accessibility Checks"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/troychaplin/block-accessibility-checks-integration-example",
        "ref": "main",
        "refType": "branch",
        "path": "/"
      },
      "options": {
        "activate": false,
        "targetFolderName": "block-accessibility-checks-integration-example"
      },
      "progress": {
        "caption": "Installing integration example plugin"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire_once '/wordpress/wp-load.php';\nrequire_once '/wordpress/wp-admin/includes/plugin.php';\n$result = activate_plugin( 'block-accessibility-checks-integration-example/plugin.php' );\nif ( is_wp_error( $result ) ) {\n\tthrow new Exception( $result->get_error_message() );\n}\n",
      "progress": {
        "caption": "Activating integration example plugin"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire_once '/wordpress/wp-load.php';\n$content = <<<'HTML'\n<!-- wp:paragraph -->\n<p><strong>Block Accessibility Checks</strong> helps you catch common accessibility issues directly in the WordPress block editor, before content ever reaches your visitors. This demo environment has the plugin installed and activated alongside an integration example that registers custom blocks and a Band post type \u2014 giving you a realistic look at how checks surface across different content types.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"/validation-page-example/\">View a page example</a> \u2014 contains validations for core blocks and custom blocks </li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"/band/the-midnight-ramblers/\">View a custom post type example</a> \u2014 contains validations for core blocks, custom blocks and post meta</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"/wp-admin/admin.php?page=block-a11y-checks\">View the plugin settings page</a> \u2014 uses DataViews and integrates with external block plugins</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\nHTML;\n$id = wp_insert_post(\n\tarray(\n\t\t'post_type'    => 'page',\n\t\t'post_status'  => 'publish',\n\t\t'post_title'   => 'Block Accessibility Checks Demo',\n\t\t'post_name'    => 'demo',\n\t\t'post_content' => $content,\n\t),\n\ttrue\n);\nif ( is_wp_error( $id ) ) {\n\tthrow new Exception( $id->get_error_message() );\n}\nupdate_option( 'show_on_front', 'page' );\nupdate_option( 'page_on_front', $id );\n",
      "progress": {
        "caption": "Creating front page"
      }
    },
    {
      "step": "runPHP",
