/a></p></div>\n<!-- /wp:validation-api-example/album-card --></div>\n<!-- /wp:validation-api-example/card-grid -->\n\n<!-- wp:paragraph -->\n<p>As a new WordPress user, you should go to <a href=\"/wp-admin/\">your dashboard</a> to delete this page and create new pages for your content. Have fun!</p>\n<!-- /wp:paragraph -->\nHTML;\n$result = wp_insert_post(\n\tarray(\n\t\t'post_type'    => 'page',\n\t\t'post_status'  => 'publish',\n\t\t'post_title'   => 'Validation Page Example',\n\t\t'post_content' => $content,\n\t),\n\ttrue\n);\nif ( is_wp_error( $result ) ) {\n\terror_log( 'Failed to create sample page: ' . $result->get_error_message() );\n}\n",
